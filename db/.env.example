# Copie para .env e preencha. O .env NAO vai para o git (ver .gitignore).
# Nenhum valor real de senha, token ou chave entra neste arquivo.

# ---- Postgres local (docker compose) ----
POSTGRES_DB=alavanca
# Dono do banco: roda as migrations e e dono dos objetos. Nao e usado pela aplicacao.
POSTGRES_USER=alavanca_owner
POSTGRES_PASSWORD=
# Porta no host. 5433 para nao bater com um Postgres ja instalado.
POSTGRES_PORT=5433

# ---- Papel de aplicacao ----
# Role alavanca_app: sem superuser, sem BYPASSRLS. E com ela que o painel e o
# worker conectam. O aplicar.sh/.ps1 define esta senha via ALTER ROLE; ela nunca
# e escrita dentro de nenhuma migration.
ALAVANCA_APP_PASSWORD=

# ---- Conexoes ----
# Usada pelo painel (Next.js) e pelo worker. Sempre com a role de aplicacao.
# Formato: postgres://alavanca_app:SENHA@127.0.0.1:5433/alavanca
DATABASE_URL=

# Opcional: se apontar para um Postgres que NAO e o do docker compose, o
# aplicar.sh/.ps1 usa esta URL com psql local em vez de entrar no container.
ALAVANCA_ADMIN_DATABASE_URL=
