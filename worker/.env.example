# Copie para worker/.env e preencha. O .env NAO vai para o git (ver .gitignore).
# Nenhum valor real de senha, token ou chave entra neste arquivo.
#
# Se voce ja preencheu db/.env, o worker usa aquele: nao precisa duplicar.

# ---- Conexao ----
# SEMPRE a role de aplicacao (alavanca_app), nunca o dono do banco.
# A role nao tem superuser nem BYPASSRLS: o importador e obrigado a setar
# app.tenant_id em cada transacao, igual ao painel.
# Formato: postgres://alavanca_app:SENHA@127.0.0.1:5433/alavanca
DATABASE_URL=

# ---- Opcional ----
# Role a assumir dentro da transacao (SET LOCAL ROLE). Existe para ambiente de
# teste onde so ha um usuario no cluster e seria facil rodar sem RLS sem
# perceber. Em producao deixe VAZIO: a conexao ja e alavanca_app.
ALAVANCA_DB_ROLE=
