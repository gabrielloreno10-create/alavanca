# Copie para .env.local e preencha. O .env.local NAO vai para o git.
# Nenhum valor real de senha, token ou chave entra neste arquivo.

# ---- Banco ----
# Role de APLICACAO (alavanca_app). Nunca a role dona: superuser passa por cima da RLS.
# Formato: postgres://alavanca_app:SENHA@127.0.0.1:5433/alavanca
# Sem esta variavel o painel entra no MODO DE SEMENTE e le os JSON de
# src/data/clientes/ em vez do Postgres. O modo aparece na tela e no console.
DATABASE_URL=

# Tamanho do pool de conexoes do painel (opcional, padrao 5).
DATABASE_POOL_MAX=

# ---- Sessao (Auth.js / next-auth) ----
# Segredo que assina o JWT da sessao. Gere com: openssl rand -base64 32
AUTH_SECRET=

# URL publica do painel, quando ele nao roda em localhost.
# AUTH_URL=

# ---- Primeiro usuario (script scripts/criar-admin.mjs) ----
# Usadas SO na linha de comando, nunca em tempo de execucao do painel.
# ALAVANCA_ADMIN_EMAIL=
# ALAVANCA_ADMIN_NOME=
# ALAVANCA_ADMIN_SENHA=
# ALAVANCA_ADMIN_PAPEL=platform_admin
# Conexao com a role dona, so para ligar o usuario aos tenants (a RLS esconde
# a tabela tenants da role de aplicacao).
# ALAVANCA_ADMIN_DATABASE_URL=

# ---- Login do modo de semente (so quando NAO ha DATABASE_URL) ----
# Hash bcrypt, nunca a senha. Gere com:
#   ALAVANCA_ADMIN_SENHA=... npm run criar-admin -- --hash
# ALAVANCA_SEED_ADMIN_EMAIL=
# ALAVANCA_SEED_ADMIN_SENHA_HASH=

# Role a assumir dentro da transacao (SET LOCAL ROLE). Use alavanca_app com o banco
# embarcado de desenvolvimento (db/dev), que tem um usuario so e ele e superuser:
# sem isto a RLS nao barra nada e o dev mente. Em producao deixe VAZIO, porque a
# conexao ja e da role alavanca_app.
ALAVANCA_DB_ROLE=
